      "grammar": [
        {
          "t": "Hỏi nơi ở: 住, 在, 住在",
          "rule": "住 nói về nơi sống lâu dài, 在 nói về đang có mặt ở đâu. Hỏi nhà ở đâu dùng 家在哪儿, hỏi địa chỉ dùng 地址是什么.",
          "ex": [
            {
              "zh": "他住哪儿？",
              "vi": "Anh ấy sống ở đâu?"
            },
            {
              "zh": "你家在哪儿？",
              "vi": "Nhà bạn ở đâu?"
            },
            {
              "zh": "你住在哪儿？",
              "vi": "Bạn sống ở đâu?"
            }
          ]
        },
        {
          "t": "Hỏi ai đó có mặt không: 在吗",
          "rule": "Tên người hoặc đại từ + 在吗. Trả lời có mặt là 在, không có mặt là 不在.",
          "ex": [
            {
              "zh": "你哥在吗？",
              "vi": "Anh bạn có nhà không?"
            },
            {
              "zh": "他不在，他去玩儿了。",
              "vi": "Anh ấy không có nhà, đi chơi rồi."
            }
          ]
        },
        {
          "t": "Đọc địa chỉ",
          "rule": "Đọc từ lớn đến nhỏ, ngược với tiếng Việt: tỉnh thành, quận huyện, phường xã, đường, số nhà, tầng, phòng.",
          "ex": [
            {
              "zh": "你住几号？",
              "vi": "Bạn ở số mấy?"
            },
            {
              "zh": "我住在四百四十号。",
              "vi": "Tôi ở số 440."
            }
          ]
        },
        {
          "t": "Đọc số 1 trong dãy số: yāo",
          "rule": "Khi đọc số nhà, số điện thoại, số khẩn cấp, số 1 đọc là yāo để khỏi nhầm với 七 (qī).",
          "ex": [
            {
              "zh": "一一零",
              "vi": "yāo yāo líng (110, gọi công an)"
            },
            {
              "zh": "一零七",
              "vi": "yāo líng qī (107)"
            }
          ]
        },
        {
          "t": "Hỏi số điện thoại",
          "rule": "你的手机号码是多少 hoặc 是什么. Trả lời: 我的手机号码是 + dãy số.",
          "ex": [
            {
              "zh": "你的手机号码是多少？",
              "vi": "Số điện thoại của bạn là bao nhiêu?"
            },
            {
              "zh": "你妹妹的电话号码是什么？",
              "vi": "Số điện thoại của em gái bạn là gì?"
            }
          ]
        },
        {
          "t": "Trợ từ ngữ khí 呢",
          "rule": "Đặt cuối câu. Ở câu hỏi làm giọng mềm hơn (nhỉ, vậy). Ở câu kể mang ý nhấn nhẹ, báo cho người nghe (đấy, đâu nhé).",
          "ex": [
            {
              "zh": "他住哪儿呢？",
              "vi": "Anh ấy ở đâu nhỉ?"
            },
            {
              "zh": "外面有人叫你呢。",
              "vi": "Bên ngoài có người gọi bạn đấy."
            }
          ]
        }
      ]
    },
